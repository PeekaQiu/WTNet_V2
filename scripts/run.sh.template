#!/bin/bash
#SBATCH --job-name=train_wtnet
#SBATCH --output=logs/train_cec_%j.out
#SBATCH --error=logs/train_cec_%j.err
#SBATCH --account=mscaisuperpod
#SBATCH --partition=normal
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --time=08:00:00

mkdir -p logs

srun --account=mscaisuperpod --partition=normal --gpus=1 \
     --container-image="/home/ldingaj/project/mia/WTNet_V2/scripts/wtnet.sqsh" \
     --container-mounts="/home/ldingaj/project/mia/WTNet_V2:/workspace" \
     --no-container-mount-home \
     bash -c "cd /workspace && \
              export PYTHONPATH=/workspace:${PYTHONPATH:-}; \
              export PYTHONUSERBASE=/workspace/.python-user-base; \
              export PATH=\$PYTHONUSERBASE/bin:\$PATH; \
              python3 -m pip install --no-cache-dir --user -q ptwt==0.1.2; \
              python3 basicsr/train.py --opt ./Options/WTNet_CEC.yml"

